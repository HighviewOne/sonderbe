# Copy to server/.env and fill in. Render needs the same vars (plus NODE_ENV=production).

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local dev port (Render assigns its own PORT)
PORT=3001

# Stripe — Developers → API keys / Webhooks; price ID starts with price_ (not prod_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# CORS origin and Stripe redirect base
FRONTEND_URL=http://localhost:5173

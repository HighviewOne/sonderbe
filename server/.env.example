# Copy to server/.env and fill in. Render needs the same vars (plus NODE_ENV=production).

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Local dev port (Render assigns its own PORT)
PORT=3001

# Stripe — Developers → API keys / Webhooks; price ID starts with price_ (not prod_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# CORS origin and Stripe redirect base
# Comma-separate several origins if needed (demo site: its preview URL)
FRONTEND_URL=http://localhost:5173

# --- Local TEST environment only (server/.env.test.local); never set these on Render ---
# Shows "Skip payment (test only)" on the subscribe page. Ignored for the live Supabase project.
# DEMO_MODE=true
# Requests allowed per client IP per 15 minutes (default 200). Raised locally for the API test suites.
# RATE_LIMIT_MAX=5000
